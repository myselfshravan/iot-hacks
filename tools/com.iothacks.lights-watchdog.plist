<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Login service for tools/lights_watchdog.py. Installed by `make lights-watchdog`
     (REPO is replaced with the repo path). Log: /tmp/lights-watchdog.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.iothacks.lights-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>REPO/tools/lights_watchdog.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/lights-watchdog.log</string>
  <key>StandardErrorPath</key><string>/tmp/lights-watchdog.log</string>
</dict>
</plist>
