# Copy to .env (git-ignored) and fill in. Any OpenAI-compatible provider works:
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
#   Anthropic  LLM_BASE_URL=https://api.anthropic.com/v1/        LLM_MODEL=claude-haiku-5-5
#   xAI Grok   LLM_BASE_URL=https://api.x.ai/v1                  LLM_MODEL=grok-3-mini
#   Ollama     LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.2
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Dexi on the LAN
DEXI_URL=http://dexi.local

# Who Dexi lives with, and where (for weather)
OWNER_NAME=Shravan
LATITUDE=12.97
LONGITUDE=77.59

# How often Dexi "thinks" on its own (seconds); petting triggers a thought immediately
THINK_EVERY_S=180

# Share the name of the frontmost Mac app with the LLM (lets Dexi comment on what you're doing)
SHARE_ACTIVE_APP=1
